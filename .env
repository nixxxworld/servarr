###############################################
# Default UID/GID And Timezone
###############################################
TZ=America/Toronto
PUID=1000
PGID=1000

###############################################
# VPN Provider and Type
###############################################
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard

###############################################
# Needed for Airvpn
# Manage your port fowarding on their website
###############################################
FIREWALL_VPN_INPUT_PORTS=X

###############################################
# Disable unbound DNS resolver
###############################################
BLOCK_MALICIOUS=off

###############################################
# Replace "X" with vaviables from config file
# Generated a config file on airvpn's website
###############################################
WIREGUARD_PUBLIC_KEY=X
WIREGUARD_PRIVATE_KEY=X
WIREGUARD_PRESHARED_KEY=X
WIREGUARD_ADDRESSES=X

###############################################
# May cause issues, if so remove or comment out
# Repace "X" with VPN's location from config
###############################################
SERVER_COUNTRIES=X
SERVER_CITIES=X

###############################################
# VPN heath check duration
###############################################
HEALTH_VPN_DURATION_INITIAL=120s

###############################################
# Static IPs for services on servarrnetwork
###############################################
IP_GLUETUN=172.X.0.X
IP_SONARR=172.X.0.X
IP_RADARR=172.X.0.X
IP_LIDARR=172.X.0.X
IP_BAZARR=172.X.0.X
IP_SEERR=172.X.0.X
IP_REQUESTRR=172.X.0.X
IP_PLEX=172.X.0.X
IP_PROFILARR=172.X.0.X
IP_DISPATCHARR=172.X.0.X
IP_RECLAIMERR=172.X.0.X
IP_CLEANUPARR=172.X.0.X
IP_TAUTULLI=172.X.0.X
IP_HOMEPAGE=172.X.0.X
IP_WIZARR=172.X.0.X
IP_MUSICSEERR=172.X.0.X
IP_DOCKHAND=172.X.0.X
IP_QUI=172.X.0.X
IP_GLANCE=172.X.0.X
IP_LIBRESEERR=172.X.0.X
IP_READARR=172.X.0.X

